<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

	<display-name>MusixConnection</display-name>
	<description>Prototipo MusixConnection - persistenza a forza bruta (JDBC/MySQL)</description>

	<!-- Inizializzazione del database all'avvio: crea le tabelle e i dati demo -->
	<listener>
		<listener-class>it.unibo.tw.web.controller.InizializzazioneDB</listener-class>
	</listener>

	<!-- ===== Servlet ===== -->
	<servlet>
		<servlet-name>Registrazione</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.RegistrazioneServlet</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Login</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.LoginServlet</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Logout</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.LogoutServlet</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Profilo</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.ProfiloServlet</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Associazione</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.AssociazioneServlet</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>Messaggio</servlet-name>
		<servlet-class>it.unibo.tw.web.controller.MessaggioServlet</servlet-class>
	</servlet>

	<!-- ===== Mapping ===== -->
	<servlet-mapping>
		<servlet-name>Registrazione</servlet-name>
		<url-pattern>/Registrazione</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Login</servlet-name>
		<url-pattern>/Login</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Logout</servlet-name>
		<url-pattern>/Logout</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Profilo</servlet-name>
		<url-pattern>/Profilo</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Associazione</servlet-name>
		<url-pattern>/Associazione</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>Messaggio</servlet-name>
		<url-pattern>/Messaggio</url-pattern>
	</servlet-mapping>

	<!-- Pagina di benvenuto -->
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<!-- Gestione errori -->
	<error-page>
		<error-code>404</error-code>
		<location>/errors/notfound.html</location>
	</error-page>
	<error-page>
		<exception-type>javax.servlet.ServletException</exception-type>
		<location>/errors/failure.jsp</location>
	</error-page>
</web-app>
